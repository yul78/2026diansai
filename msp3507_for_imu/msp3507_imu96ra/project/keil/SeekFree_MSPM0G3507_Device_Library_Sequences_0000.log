[23:04:21.823]          WriteDP(SW_DP_ABORT, 0x0000001E);
[23:04:21.823]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[23:04:21.823]        </block>
[23:04:21.823]        // end if-block "(__protocol & 0xFFFF) == 2"
[23:04:21.823]      </control>
[23:04:21.823]      // end if-block "powered_down"
