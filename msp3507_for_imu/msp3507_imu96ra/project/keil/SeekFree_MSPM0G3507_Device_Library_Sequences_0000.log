[23:04:21.802]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[23:04:21.802]    <block atomic="false" info="">
[23:04:21.802]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[23:04:21.802]        // -> [isSWJ <= 0x00000001]
[23:04:21.803]      __var hasDormant = __protocol & 0x00020000;
[23:04:21.803]        // -> [hasDormant <= 0x00000000]
[23:04:21.803]      __var protType   = __protocol & 0x0000FFFF;
[23:04:21.803]        // -> [protType <= 0x00000002]
[23:04:21.803]    </block>
[23:04:21.803]    <control if="protType == 1" while="" timeout="0" info="">
[23:04:21.803]      // if-block "protType == 1"
[23:04:21.803]        // =>  FALSE
[23:04:21.803]      // skip if-block "protType == 1"
[23:04:21.803]    </control>
[23:04:21.803]    <control if="protType == 2" while="" timeout="0" info="">
[23:04:21.803]      // if-block "protType == 2"
[23:04:21.803]        // =>  TRUE
[23:04:21.803]      <control if="isSWJ" while="" timeout="0" info="">
[23:04:21.804]        // if-block "isSWJ"
[23:04:21.804]          // =>  TRUE
[23:04:21.804]        <control if="hasDormant" while="" timeout="0" info="">
[23:04:21.804]          // if-block "hasDormant"
[23:04:21.804]            // =>  FALSE
[23:04:21.804]          // skip if-block "hasDormant"
[23:04:21.804]        </control>
[23:04:21.804]        <control if="!hasDormant" while="" timeout="0" info="">
[23:04:21.804]          // if-block "!hasDormant"
[23:04:21.804]            // =>  TRUE
[23:04:21.804]          <block atomic="false" info="">
[23:04:21.804]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[23:04:21.805]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[23:04:21.805]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[23:04:21.806]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[23:04:21.806]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[23:04:21.807]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[23:04:21.807]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[23:04:21.808]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[23:04:21.808]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[23:04:21.808]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[23:04:21.808]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[23:04:21.808]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[23:04:21.809]          </block>
[23:04:21.809]          // end if-block "!hasDormant"
[23:04:21.809]        </control>
[23:04:21.809]        // end if-block "isSWJ"
[23:04:21.809]      </control>
[23:04:21.809]      <control if="!isSWJ" while="" timeout="0" info="">
[23:04:21.809]        // if-block "!isSWJ"
[23:04:21.810]          // =>  FALSE
[23:04:21.810]        // skip if-block "!isSWJ"
[23:04:21.810]      </control>
