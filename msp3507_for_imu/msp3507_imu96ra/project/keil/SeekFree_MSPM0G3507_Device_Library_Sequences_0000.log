[23:04:21.813]        // -> [DP_CTRL_STAT <= 0x00000004]
[23:04:21.813]      __var DP_SELECT         = 0x8;
[23:04:21.813]        // -> [DP_SELECT <= 0x00000008]
[23:04:21.813]      __var powered_down      = 0;
[23:04:21.813]        // -> [powered_down <= 0x00000000]
[23:04:21.813]      WriteDP(DP_SELECT, 0x00000000);
[23:04:21.814]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[23:04:21.814]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[23:04:21.814]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[23:04:21.814]        // -> [powered_down <= 0x00000001]
[23:04:21.814]    </block>
[23:04:21.814]    <control if="powered_down" while="" timeout="0" info="">
