[23:04:21.810]        ReadDP(0x0);
[23:04:21.810]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[23:04:21.811]      </block>
[23:04:21.811]      // end if-block "protType == 2"
[23:04:21.811]    </control>
[23:04:21.811]  </sequence>
