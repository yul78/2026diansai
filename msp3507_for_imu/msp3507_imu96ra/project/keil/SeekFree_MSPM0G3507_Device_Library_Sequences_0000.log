[23:04:21.824]      WriteAP(0x0C, 0x04); //lets use the mini pwr-ap as backup
[23:04:21.824]        // -> [WriteAP(0x0000000C, 0x00000004)]   (__dp=0x00000000, __ap=0x00000001)
[23:04:21.825]      __ap = 4;
