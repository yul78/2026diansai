[23:04:21.815]      <block atomic="false" info="">
[23:04:21.815]        Message(0, "Debug/System power-up request sent");
[23:04:21.817]        WriteDP(DP_CTRL_STAT, 0x50000000);
[23:04:21.817]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[23:04:21.817]      </block>
[23:04:21.819]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
