[23:04:21.819]          // =>  FALSE
[23:04:21.820]        // skip if-block "(__protocol & 0xFFFF) == 1"
[23:04:21.820]      </control>
[23:04:21.820]      <control if="(__protocol & 0xFFFF) == 2" while="" timeout="0" info="">
[23:04:21.820]        // if-block "(__protocol & 0xFFFF) == 2"
[23:04:21.820]          // =>  TRUE
[23:04:21.820]        <block atomic="false" info="">
[23:04:21.820]          Message(0, "executing SWD power up");
[23:04:21.822]          WriteDP(DP_CTRL_STAT, 0x50000F00);
