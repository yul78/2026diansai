[23:04:21.819]          // -> [ReadDP(0x00000004) => 0xF0000040]   (__dp=0x00000000)
[23:04:21.819]        // while-condition  =>  FALSE
[23:04:21.819]        // end while "(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000"
[23:04:21.819]      </control>
[23:04:21.819]      <control if="(__protocol & 0xFFFF) == 1" while="" timeout="0" info="">
