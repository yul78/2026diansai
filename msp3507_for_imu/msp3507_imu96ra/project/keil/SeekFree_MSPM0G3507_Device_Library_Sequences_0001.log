[00:24:21.400]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[00:24:21.400]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
