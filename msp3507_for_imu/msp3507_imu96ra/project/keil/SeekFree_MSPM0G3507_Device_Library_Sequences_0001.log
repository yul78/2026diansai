[00:16:11.916]          WriteDP(SW_DP_ABORT, 0x0000001E);
[00:16:11.916]            // -> [WriteDP(0x00000000, 0x0000001E)]   (__dp=0x00000000)
[00:16:11.916]        </block>
[00:16:11.916]        // end if-block "(__protocol & 0xFFFF) == 2"
[00:16:11.916]      </control>
