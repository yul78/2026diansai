[00:24:21.401]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[00:24:21.401]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[00:24:21.401]          </block>
[00:24:21.401]          // end if-block "!hasDormant"
