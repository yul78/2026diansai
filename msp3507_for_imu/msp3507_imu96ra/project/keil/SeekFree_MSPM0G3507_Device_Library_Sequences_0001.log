[00:24:21.399]        <control if="!hasDormant" while="" timeout="0" info="">
[00:24:21.399]          // if-block "!hasDormant"
[00:24:21.399]            // =>  TRUE
[00:24:21.399]          <block atomic="false" info="">
[00:24:21.399]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[00:24:21.399]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:24:21.400]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
