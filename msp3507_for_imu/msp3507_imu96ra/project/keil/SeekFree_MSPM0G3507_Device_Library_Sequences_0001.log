[00:16:04.215]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[00:16:04.215]    <block atomic="false" info="">
[00:16:04.215]      __var deviceID = 0;
[00:16:04.215]        // -> [deviceID <= 0x00000000]
[00:16:04.215]      __var version = 0;
[00:16:04.215]        // -> [version <= 0x00000000]
[00:16:04.215]      __var partNum = 0;
[00:16:04.215]        // -> [partNum <= 0x00000000]
[00:16:04.215]      __var manuf = 0;
[00:16:04.215]        // -> [manuf <= 0x00000000]
[00:16:04.215]      __var isMSPM0G1X0X_G3X0X = 0;
[00:16:04.215]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[00:16:04.215]      __var isProduction = 0;
[00:16:04.215]        // -> [isProduction <= 0x00000000]
[00:16:04.216]      __var continueId = 0;
[00:16:04.216]        // -> [continueId <= 0x00000000]
[00:16:04.216]      deviceID =   Read32(0x41C40004);
[00:16:04.217]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[00:16:04.217]        // -> [deviceID <= 0x2BB8802F]
[00:16:04.217]      version = deviceID >> 28;
[00:16:04.217]        // -> [version <= 0x00000002]
[00:16:04.217]      partNum = (deviceID & 0x0FFFF000) >> 12;
[00:16:04.217]        // -> [partNum <= 0x0000BB88]
[00:16:04.217]      manuf = (deviceID & 0x00000FFE) >> 1;
[00:16:04.217]        // -> [manuf <= 0x00000017]
[00:16:04.217]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[00:16:04.217]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[00:16:04.217]      isProduction = (version > 0);
[00:16:04.217]        // -> [isProduction <= 0x00000001]
[00:16:04.217]    </block>
[00:16:04.218]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[00:16:04.218]      // if-block "!isMSPM0G1X0X_G3X0X"
[00:16:04.218]        // =>  FALSE
[00:16:04.218]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[00:16:04.218]    </control>
