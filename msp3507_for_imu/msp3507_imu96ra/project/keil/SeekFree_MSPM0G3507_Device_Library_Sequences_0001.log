[00:16:04.181]      // skip if-block "protType == 1"
[00:16:04.181]    </control>
[00:16:04.181]    <control if="protType == 2" while="" timeout="0" info="">
[00:16:04.181]      // if-block "protType == 2"
[00:16:04.181]        // =>  TRUE
[00:16:04.181]      <control if="isSWJ" while="" timeout="0" info="">
[00:16:04.182]        // if-block "isSWJ"
[00:16:04.182]          // =>  TRUE
[00:16:04.182]        <control if="hasDormant" while="" timeout="0" info="">
[00:16:04.182]          // if-block "hasDormant"
[00:16:04.182]            // =>  FALSE
[00:16:04.182]          // skip if-block "hasDormant"
[00:16:04.182]        </control>
[00:16:04.182]        <control if="!hasDormant" while="" timeout="0" info="">
[00:16:04.182]          // if-block "!hasDormant"
[00:16:04.183]            // =>  TRUE
[00:16:04.183]          <block atomic="false" info="">
[00:16:04.183]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[00:16:04.183]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:16:04.183]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[00:16:04.183]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[00:16:04.184]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[00:16:04.184]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:16:04.184]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[00:16:04.184]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[00:16:04.184]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[00:16:04.185]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:16:04.185]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[00:16:04.185]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[00:16:04.185]          </block>
[00:16:04.185]          // end if-block "!hasDormant"
[00:16:04.185]        </control>
[00:16:04.185]        // end if-block "isSWJ"
[00:16:04.185]      </control>
