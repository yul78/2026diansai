[00:16:04.180]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[00:16:04.180]    <block atomic="false" info="">
[00:16:04.180]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[00:16:04.181]        // -> [isSWJ <= 0x00000001]
