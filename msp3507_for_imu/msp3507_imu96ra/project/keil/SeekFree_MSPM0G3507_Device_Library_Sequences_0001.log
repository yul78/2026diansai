[00:16:11.912]        // -> [DP_CTRL_STAT <= 0x00000004]
[00:16:11.912]      __var DP_SELECT         = 0x8;
[00:16:11.912]        // -> [DP_SELECT <= 0x00000008]
[00:16:11.912]      __var powered_down      = 0;
[00:16:11.912]        // -> [powered_down <= 0x00000000]
[00:16:11.912]      WriteDP(DP_SELECT, 0x00000000);
[00:16:11.913]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
