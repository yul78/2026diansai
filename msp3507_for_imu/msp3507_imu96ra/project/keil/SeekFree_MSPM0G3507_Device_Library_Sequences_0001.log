[00:16:11.905]  
[00:16:11.905]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[00:16:11.905]    <block atomic="false" info="">
[00:16:11.905]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[00:16:11.905]        // -> [isSWJ <= 0x00000001]
[00:16:11.905]      __var hasDormant = __protocol & 0x00020000;
[00:16:11.906]        // -> [hasDormant <= 0x00000000]
[00:16:11.906]      __var protType   = __protocol & 0x0000FFFF;
[00:16:11.906]        // -> [protType <= 0x00000002]
[00:16:11.906]    </block>
[00:16:11.906]    <control if="protType == 1" while="" timeout="0" info="">
[00:16:11.906]      // if-block "protType == 1"
[00:16:11.906]        // =>  FALSE
[00:16:11.906]      // skip if-block "protType == 1"
[00:16:11.906]    </control>
[00:16:11.906]    <control if="protType == 2" while="" timeout="0" info="">
[00:16:11.906]      // if-block "protType == 2"
[00:16:11.906]        // =>  TRUE
[00:16:11.906]      <control if="isSWJ" while="" timeout="0" info="">
[00:16:11.906]        // if-block "isSWJ"
[00:16:11.906]          // =>  TRUE
[00:16:11.906]        <control if="hasDormant" while="" timeout="0" info="">
[00:16:11.907]          // if-block "hasDormant"
[00:16:11.907]            // =>  FALSE
[00:16:11.907]          // skip if-block "hasDormant"
[00:16:11.907]        </control>
[00:16:11.907]        <control if="!hasDormant" while="" timeout="0" info="">
[00:16:11.907]          // if-block "!hasDormant"
[00:16:11.907]            // =>  TRUE
[00:16:11.907]          <block atomic="false" info="">
[00:16:11.907]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[00:16:11.907]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:16:11.907]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[00:16:11.907]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[00:16:11.907]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[00:16:11.907]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:16:11.908]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[00:16:11.908]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[00:16:11.908]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[00:16:11.908]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[00:16:11.908]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[00:16:11.908]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[00:16:11.908]          </block>
[00:16:11.908]          // end if-block "!hasDormant"
[00:16:11.909]        </control>
[00:16:11.909]        // end if-block "isSWJ"
[00:16:11.909]      </control>
[00:16:11.909]      <control if="!isSWJ" while="" timeout="0" info="">
[00:16:11.909]        // if-block "!isSWJ"
[00:16:11.909]          // =>  FALSE
[00:16:11.909]        // skip if-block "!isSWJ"
[00:16:11.909]      </control>
[00:16:11.909]      <block atomic="false" info="">
[00:16:11.909]        ReadDP(0x0);
[00:16:11.909]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[00:16:11.909]      </block>
[00:16:11.909]      // end if-block "protType == 2"
[00:16:11.909]    </control>
[00:16:11.909]  </sequence>
