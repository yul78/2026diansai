[00:24:21.398]        // if-block "isSWJ"
[00:24:21.398]          // =>  TRUE
[00:24:21.399]        <control if="hasDormant" while="" timeout="0" info="">
[00:24:21.399]          // if-block "hasDormant"
[00:24:21.399]            // =>  FALSE
[00:24:21.399]          // skip if-block "hasDormant"
