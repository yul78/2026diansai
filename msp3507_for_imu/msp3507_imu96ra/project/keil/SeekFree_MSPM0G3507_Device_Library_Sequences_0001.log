[00:24:21.401]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[00:24:21.401]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
